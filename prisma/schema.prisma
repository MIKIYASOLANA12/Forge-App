generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Domain {
  id       String    @id @default(cuid())
  name     String    // "Workout", "Study", "Coding", "Reading", "Business", "Faith"
  color    String    // hex color
  icon     String    @default("circle")
  weight   Float     @default(1.0)
  sessions Session[]
  habits   Habit[]
  lessons  Lesson[]
}

model Session {
  id        String   @id @default(cuid())
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id])
  startedAt DateTime
  minutes   Int
  note      String?
  xpEarned  Int
}

model WorkoutProgram {
  id          String   @id @default("singleton")
  startDate   DateTime
  currentWeek Int      @default(1)
}

model WorkoutDay {
  id        String           @id @default(cuid())
  type      String
  exercises WorkoutExercise[]
  logs      WorkoutLog[]
}

model WorkoutExercise {
  id           String         @id @default(cuid())
  workoutDayId String
  workoutDay   WorkoutDay     @relation(fields: [workoutDayId], references: [id])
  name         String
  order        Int
  logs         ExerciseLog[]
}

model WorkoutLog {
  id           String        @id @default(cuid())
  workoutDayId String
  workoutDay   WorkoutDay    @relation(fields: [workoutDayId], references: [id])
  completedAt  DateTime      @default(now())
  weekNumber   Int
  notes        String?
  exerciseLogs ExerciseLog[]
}

model ExerciseLog {
  id            String          @id @default(cuid())
  workoutLogId  String
  workoutLog    WorkoutLog      @relation(fields: [workoutLogId], references: [id])
  exerciseId    String
  exercise      WorkoutExercise @relation(fields: [exerciseId], references: [id])
  setsCompleted Int
  repsCompleted Int
  weightKg      Float?
  checked       Boolean         @default(false)
}

model Habit {
  id              String     @id @default(cuid())
  domainId        String
  domain          Domain     @relation(fields: [domainId], references: [id])
  name            String
  active          Boolean    @default(true)
  streakCount     Int        @default(0)
  streakStartedAt DateTime?
  lastCompletedAt DateTime?
  logs            HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id])
  date      DateTime
  completed Boolean
}

model Lesson {
  id       String  @id @default(cuid())
  domainId String
  domain   Domain  @relation(fields: [domainId], references: [id])
  track    String
  title    String
  content  String
  order    Int
  quiz     Quiz?
}

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String         @unique
  lesson    Lesson         @relation(fields: [lessonId], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  quiz         Quiz   @relation(fields: [quizId], references: [id])
  prompt       String
  options      String // JSON array
  correctIndex Int
}

model QuizAttempt {
  id      String   @id @default(cuid())
  quizId  String
  quiz    Quiz     @relation(fields: [quizId], references: [id])
  score   Int
  takenAt DateTime @default(now())
  passed  Boolean  @default(false)
}

model UserProfile {
  id            String   @id @default("singleton")
  totalXp       Int      @default(0)
  level         Int      @default(1)
  examDate      DateTime
  planStartDate DateTime
  calorieTarget Int      @default(2500)
  proteinTarget Float    @default(180)
  carbTarget    Float    @default(300)
  fatTarget     Float    @default(70)
  targetCalories Int     @default(2500)
  targetProtein  Int     @default(150)
  targetCarbs    Int     @default(300)
  targetFat      Int     @default(80)
}

model DailyPlan {
  id            String     @id @default(cuid())
  date          DateTime   @unique
  generatedByAI Boolean    @default(true)
  tasks         PlanTask[]
  createdAt     DateTime   @default(now())
}

model PlanTask {
  id            String    @id @default(cuid())
  dailyPlanId   String
  dailyPlan     DailyPlan @relation(fields: [dailyPlanId], references: [id])
  domainId      String
  description   String
  minutesTarget Int
  completed     Boolean   @default(false)
  googleEventId String?
}

model Meal {
  id            String     @id @default(cuid())
  eatenAt       DateTime
  label         String
  items         FoodItem[]
  totalCalories Int        @default(0)
  totalProtein  Float      @default(0)
  totalCarbs    Float      @default(0)
  totalFat      Float      @default(0)
}

model FoodItem {
  id       String @id @default(cuid())
  mealId   String
  meal     Meal   @relation(fields: [mealId], references: [id])
  name     String
  quantity String
  calories Int
  protein  Float
  carbs    Float
  fat      Float
}

model Book {
  id          String        @id @default(cuid())
  title       String
  author      String?
  sourceFile  String?
  chunks      String?       // JSON array of text chunks indexed by chapter
  order       Int
  status      String        @default("queued") // queued | reading | finished
  currentPage Int           @default(0)
  checkIns    BookCheckIn[]
}

model BookCheckIn {
  id           String   @id @default(cuid())
  bookId       String
  book         Book     @relation(fields: [bookId], references: [id])
  askedAt      DateTime @default(now())
  question     String
  userAnswer   String?
  aiAssessment String?
  chunkIndex   Int      @default(0)
  gapDetected  Boolean  @default(false)
}

model ScripturePlanItem {
  id        String             @id @default(cuid())
  order     Int
  reference String
  status    String             @default("queued") // queued | done
  readAt    DateTime?
  checkIns  ScriptureCheckIn[]
}

model ScriptureCheckIn {
  id           String            @id @default(cuid())
  planItemId   String
  planItem     ScripturePlanItem @relation(fields: [planItemId], references: [id])
  askedAt      DateTime          @default(now())
  question     String
  userAnswer   String?
  aiAssessment String?
  gapDetected  Boolean           @default(false)
}

model ChatMessage {
  id          String   @id @default(cuid())
  role        String   // "user" | "agent"
  content     String
  createdAt   DateTime @default(now())
  actionTaken String?
}

model Reflection {
  id          String   @id @default(cuid())
  date        DateTime @unique
  whatWorked  String
  tomorrowKey String
  createdAt   DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id              String  @id @default("singleton")
  habitReminderAt String  @default("20:00")
  streakWarningAt String  @default("21:00")
  planReadyAt     String  @default("07:00")
  enabled         Boolean @default(true)
}

model GoogleCalendarToken {
  id           String   @id @default("singleton")
  accessToken  String
  refreshToken String
  expiresAt    DateTime
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  passwordHash  String
  emailVerified Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tokens        AuthToken[]
  sessions      UserSession[]
  telegram      TelegramAccount?
}

model AuthToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  type        String    // "ACTIVATION" | "PASSWORD_RESET"
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model TelegramAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramId   String   @unique
  chatId       String?
  username     String?
  phoneNumber  String?
  verifiedAt   DateTime @default(now())
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TelegramVerification {
  id          String   @id @default(cuid())
  chatId      String   @unique
  telegramId  String
  phoneNumber String?
  email       String?
  otpCode     String?
  otpExpiresAt DateTime?
  step        String   @default("AWAITING_PHONE") // "AWAITING_PHONE" | "AWAITING_EMAIL" | "AWAITING_OTP" | "VERIFIED"
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  ipAddress   String?
  userAgent   String?
  location    String?
  revoked     Boolean   @default(false)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastActiveAt DateTime @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  icon        String   @default("trophy")
  category    String   @default("general")
  unlockedAt  DateTime @default(now())
}

model ProgressDaily {
  id               String   @id @default(cuid())
  date             DateTime @unique
  consistencyScore Float    @default(0)
  color            String   @default("GRAY")
  workoutDone      Boolean  @default(false)
  tasksCompleted   Int      @default(0)
  tasksTotal       Int      @default(0)
  studyMinutes     Int      @default(0)
  codingMinutes    Int      @default(0)
  readingMinutes   Int      @default(0)
  nutritionScore   Float    @default(0)
  habitsCompleted  Int      @default(0)
  habitsTotal      Int      @default(0)
  xpEarned         Int      @default(0)
  strongestArea    String?
  weakestArea      String?
  summaryJson      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MonthlyProgressReport {
  id                 String   @id @default(cuid())
  year               Int
  month              Int
  totalXp            Int      @default(0)
  endingLevel        Int      @default(1)
  xpEarned           Int      @default(0)
  workoutRate        Float    @default(0)
  studyRate          Float    @default(0)
  codingRate         Float    @default(0)
  readingRate        Float    @default(0)
  nutritionScore     Float    @default(0)
  habitRate          Float    @default(0)
  perfectDays        Int      @default(0)
  missedDays         Int      @default(0)
  longestStreak      Int      @default(0)
  bestDay            String?
  weakestDay         String?
  strongestArea      String?
  weakestArea        String?
  biggestImprovement String?
  biggestDecline     String?
  reportJson         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([year, month])
}

model TelegramNotificationLog {
  id        String   @id @default(cuid())
  date      DateTime
  type      String   // "DAILY_REMINDER" | "COMPLETION_REPORT"
  sentAt    DateTime @default(now())
  chatId    String
  message   String?

  @@unique([date, type])
}

