GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres — get from neon.tech dashboard
# DATABASE_URL should use Neon's pooled connection for runtime queries.
# DIRECT_URL should use Neon's direct connection for Prisma migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Google Calendar OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback

# Web Push VAPID Keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your@email.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FORGE_PUBLIC_URL=https://your-app.vercel.app

# App URL (update when deployed)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Vercel deployment checklist:
# Add every value above in Vercel Project Settings > Environment Variables.
# Use the Production URL for NEXT_PUBLIC_APP_URL, FORGE_PUBLIC_URL and GOOGLE_REDIRECT_URI.
# Run `npm run db:push` and `npm run db:seed` once against the Neon database.
