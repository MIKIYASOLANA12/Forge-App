# AI Providers (Server-Side Only — Never expose to client)
# 1. Gemini (Vision, PDF exam papers, OCR, document parsing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# 2. OpenRouter (Deep reasoning, practice question generation, study coaching, explanations)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. Groq (Ultra-fast accountability, Telegram roasts, daily plan analysis, quick responses)
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=groq/compound-mini

# Neon Postgres — get from neon.tech dashboard
# DATABASE_URL should use Neon's pooled connection for runtime queries.
# DIRECT_URL should use Neon's direct connection for Prisma migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Google Calendar OAuth — from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback

# Web Push VAPID Keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your@email.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key

# Forge Authentication
AUTH_SECRET=your_random_64_character_hex_secret_here
FORGE_INITIAL_PASSWORD=your_initial_secure_password_here

# Email Delivery (Resend API - optional, defaults to terminal logger)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=FORGE OS <auth@your-app.com>

# Telegram Bot & Identity Verification
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTHORIZED_PHONE=+1234567890
FORGE_PUBLIC_URL=https://your-app.vercel.app

# App URL (update when deployed)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Vercel deployment checklist:
# Add every value above in Vercel Project Settings > Environment Variables.
# Use the Production URL for NEXT_PUBLIC_APP_URL and GOOGLE_REDIRECT_URI.
# Run `npm run db:push` and `npm run db:seed` once against the Neon database.

# Google Calendar OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/calendar/auth/callback"
